# Clocked (rezolve.ai) API key — server-side only.
#
# Do NOT put this in a .env* file. The Workers build reads every .env* variant
# and writes the values into .open-next/cloudflare/next-env.mjs, which is
# bundled into the deployed Worker — so a key in .env.local (or
# .env.development.local) ships in the artifact and shadows the Sites Secret.
#
# Instead, copy this file to .secrets.local (gitignored). next.config.ts loads it
# during `next dev` only, and deploys take the key from the Sites Secret.
#
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
CLOCKED_API_KEY=

# URL segment the working app lives under: /p/<PROTOTYPE_SLUG>. Pick anything
# unguessable. The slug is never committed and never appears in the promo page,
# so the public site advertises the product without revealing the prototype.
#
# This is the only access control: opening the URL issues a 12-hour signed pass
# (keyed by CLOCKED_API_KEY, so no extra secret to manage) that /api/clocked/*
# requires. There is no login page and no password to type.
PROTOTYPE_SLUG=
